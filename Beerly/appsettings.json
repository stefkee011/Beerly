{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=BeerlyDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },

  "Jwt": {
    "Issuer": "BeerlyApi",
    "Audience": "BeerlyApiUsers",
    "ExpiryMinutes": 60
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },

  "Images": {
    "MinSide": 400
  }
}
